# ============================================================
# BriefPilot – Vorlage für Umgebungsvariablen
# ============================================================
# „npm run setup“ kopiert diese Datei nach .env und erzeugt dabei
# automatisch neue Schlüssel. Tragen Sie hier KEINE echten Zugangsdaten ein –
# nur in die Datei .env (die nie weitergegeben oder hochgeladen werden darf).

# --- Grundeinstellungen ---
NODE_ENV=development
PORT=3000
# Adresse, unter der die App erreichbar ist (im Produktivbetrieb mit https://)
BASE_URL=http://localhost:3000
# 127.0.0.1 = nur dieser Computer. 0.0.0.0 = auch andere Geräte im WLAN.
HOST=127.0.0.1
# Ordner für Datenbank und verschlüsselte Dateien
DATA_DIR=data
# Auf 1 setzen, wenn ein Reverse-Proxy (z. B. Caddy, nginx) davor läuft
TRUST_PROXY=0

# --- Verschlüsselung der gespeicherten Briefe (PFLICHT) ---
# 32 zufällige Bytes als Base64. Wird von „npm run setup“ erzeugt.
# ACHTUNG: Geht dieser Schlüssel verloren, sind alle gespeicherten Briefe unlesbar.
FILE_ENCRYPTION_KEY=

# --- KI-Auswertung (optional, aber für Fotos nötig) ---
# Welche KI liest die Briefe?
#   gemini    = Google Gemini, kostenloses Kontingent (Standard, empfohlen zum Testen)
#   openai    = OpenAI-kompatible Schnittstelle, z. B. Ollama oder LM Studio auf diesem Computer
#   anthropic = Claude-API von Anthropic (kostenpflichtig)
#   aus       = keine KI (PDFs mit Text werden einfach erkannt, Fotos nur gespeichert)
# Leer lassen = automatisch nach vorhandenem Schlüssel.
AI_PROVIDER=

# Google Gemini – kostenloser Schlüssel: https://aistudio.google.com/apikey
# (Google-Konto, keine Kreditkarte; Nutzung ab 18 Jahren). Ohne verknüpftes Rechnungskonto entstehen keine Kosten.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Ersatzmodell, wenn das Tageskontingent des Hauptmodells aufgebraucht ist (leer = keins)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Nur auf true setzen, wenn für das Google-Projekt ein Rechnungskonto (kostenpflichtig) aktiv ist
GEMINI_PAID=false

# OpenAI-kompatibel, z. B. Ollama (100 % kostenlos, Briefe verlassen den Computer nicht):
#   OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
#   OPENAI_COMPAT_MODEL=<ein Modell mit Bildverständnis, z. B. qwen2.5vl>
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Claude-API (Anthropic): Schlüssel aus der Anthropic-Konsole (https://platform.claude.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Anzeigename des Dienstes in der App (leer = automatisch)
AI_PROVIDER_LABEL=
# Höchstzahl KI-Anfragen pro Nutzer und Tag (schützt das kostenlose Kontingent bzw. vor Kosten)
AI_DAILY_LIMIT=30
DEMO_AI_DAILY_LIMIT=5
# Wartezeit für eine KI-Antwort (Sekunden) und Pause vor einem erneuten Versuch (Millisekunden)
AI_TIMEOUT_SECONDS=180
AI_RETRY_DELAY_MS=4000

# --- E-Mail (optional; nötig für „Passwort vergessen“ im echten Betrieb und
#     zum direkten Senden von Antworten – immer erst nach ausdrücklicher Freigabe) ---
# SMTP_SECURITY: tls (meist Port 465) oder starttls (meist Port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Push-Benachrichtigungen (optional) ---
# Werden von „npm run setup“ erzeugt.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:datenschutz@example.org

# --- Demomodus ---
# Im öffentlichen Betrieb besser ausschalten (false)
DEMO_ENABLED=true
DEMO_TTL_HOURS=24

# --- Grenzen ---
MAX_FILE_MB=15
MAX_PAGES_PER_LETTER=20
MAX_STORAGE_MB_PER_USER=500

# Kontaktadresse für Datenschutzfragen (wird in der App angezeigt)
PRIVACY_CONTACT=
